# ============================================================================
# APICN001 RAG VoiceBot — configuration. Copy to .env and fill in.
# NEVER commit a real .env (it is git-ignored). This file carries NO secrets.
# ============================================================================

# ---- Required: answer generator (exact names the evaluator looks for) ----
LLM_PROVIDER=slm                       # slm | groq | openai | anthropic | openrouter   (slm is the default)
LLM_MODEL=                             # model id for the chosen provider; blank = sensible per-provider default
SLM_BASE_URL=http://localhost:11434/v1 # Ollama's OpenAI-compatible endpoint
SLM_API_KEY=ollama                     # placeholder; Ollama ignores it
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=local               # local | openai
EMBEDDING_MODEL=                       # blank = sentence-transformers/all-MiniLM-L6-v2 (local)
STT_PROVIDER=local                     # local | groq | openai   (local = faster-whisper)
TTS_PROVIDER=pyttsx3                   # pyttsx3 | piper | edge

# ---- Model hints (per provider), handy examples ----
# slm:        LLM_MODEL=llama3.1:8b      (ollama pull llama3.1:8b)  or  qwen2.5:3b for CPU
# groq:       LLM_MODEL=llama-3.3-70b-versatile
# openai:     LLM_MODEL=gpt-4o-mini
# anthropic:  LLM_MODEL=claude-3-5-haiku-20241022
# openrouter: LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# ---- Speech tuning (free choice) ----
STT_MODEL=base                         # faster-whisper size: tiny | base | small | medium
TTS_VOICE=                             # pyttsx3 system voice id, or en-IN-NeerjaNeural (edge), or a piper .onnx path
TTS_RATE=185                           # pyttsx3 words-per-minute

# ---- Retrieval tuning (free choice) ----
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- Paths ----
DATA_DIR=data
INDEX_DIR=index
